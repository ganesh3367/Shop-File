# Copy to .env for local overrides. In production set these in your host's dashboard (e.g. Render → Environment).

# --- Database ---
# Production (Render free plan): a Turso database. Create one at turso.tech, then copy its URL and a token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Development: leave the Turso values empty to use a local SQLite file instead.
DB_FILE=data/gany.db

# --- Security ---
# Long random string used to sign login tokens (required in production).
JWT_SECRET=
# First admin account, created on first start if no admin exists (required in production).
ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=4000
